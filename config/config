# Cal45 v0.1 – Radicale DAV core.
# Expose externally only behind a correctly configured HTTPS reverse proxy.
[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /etc/radicale/users
htpasswd_encryption = bcrypt

[rights]
type = owner_only

[storage]
filesystem_folder = /var/lib/radicale/collections
