# Kopieren nach .env und anpassen: cp .env.example .env
# Die echte .env ist per .gitignore ausgeschlossen.

# IP, auf der Cal45 lauscht.
#   LAN-IP des Servers -> erreichbar fuer den NetBird-Reverse-Proxy
#                         (ueber den OPNsense-Routing-Peer)
#   127.0.0.1          -> nur lokal (Default)
#   0.0.0.0            -> alle Interfaces (nicht empfohlen)
CAL45_BIND_IP=10.10.34.32

# Host-Port (im Container immer 5232)
CAL45_PORT=5232
